/// Example: "CS150Grader 1.2.3"
#define ASMGRADER_IMPL_VERSION_INFO "@ASMGRADER_IMPL_VERSION_INFO@"
#define ASMGRADER_DEPENDENCY_VERSIONS_STR "@ASMGRADER_DEPENDENCY_VERSIONS_STR@"
